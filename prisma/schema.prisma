// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Core Enums ====================

enum Status {
  ACTIVE
  INACTIVE
  SCHEDULED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PRODUCING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PriceDisplayStrategy {
  EXACT
  RANGE
  CONTACT
}

enum CodeType {
  HTML
  CSS
  JAVASCRIPT
}

enum InjectionPosition {
  HEAD
  BODY_START
  BODY_END
}

enum EntityType {
  SITE
  PAGE
  PRODUCT
  CASE
  NEWS
  MODULE
}

enum TranslationStatus {
  TRANSLATED
  PENDING
  UNTRANSLATED
}

// ==================== 1. Admin User ====================

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  nickname  String?
  password  String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ==================== 2. Template ====================

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  coverImage  String?  @map("cover_image")
  identifier  String   @unique
  status      Status   @default(ACTIVE)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pageModuleTemplates PageModuleTemplate[]

  @@map("templates")
}

// ==================== 3. Site Config ====================

model SiteConfig {
  id              String  @id @default(cuid())
  companyName     String  @map("company_name")
  companyNameEn   String? @map("company_name_en")
  companyNameEs   String? @map("company_name_es")
  companyNameAr   String? @map("company_name_ar")
  logo            String?
  primaryColor    String  @default("#0ea5e9") @map("primary_color")
  secondaryColor  String  @default("#f59e0b") @map("secondary_color")
  accentColor     String  @default("#10b981") @map("accent_color")
  siteTitle       String  @map("site_title")
  siteDescription String? @map("site_description") @db.Text
  footerInfo      String? @map("footer_info") @db.Text

  phone     String?
  email     String?
  address   String?
  mapUrl    String? @map("map_url")
  mapCoords String? @map("map_coords")

  socialLinks Json? @map("social_links")

  defaultLanguage String @default("en") @map("default_language")

  defaultSeoTitle       String? @map("default_seo_title")
  defaultSeoDescription String? @map("default_seo_description") @db.Text
  defaultSeoKeywords    String? @map("default_seo_keywords")
  defaultOgImage        String? @map("default_og_image")
  favicon               String?

  // AI Configuration
  aiEnabled   Boolean @default(false) @map("ai_enabled")
  aiProvider  String? @map("ai_provider")
  aiApiKey    String? @map("ai_api_key")
  aiModel     String? @map("ai_model")
  aiEndpoint  String? @map("ai_endpoint")
  braveSearchKey String? @map("brave_search_key")

  // Company & Contact (per-language, stored in SiteSeoConfig)

  currentTemplateId String? @map("current_template_id")

  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

// ==================== 3b. Site SEO Config (multi-language) ====================

model SiteSeoConfig {
  id                    String  @id @default(cuid())
  languageCode          String  @map("language_code")
  companyName           String? @map("company_name")
  siteTitle             String? @map("site_title")
  siteDescription       String? @map("site_description") @db.Text
  defaultSeoTitle       String? @map("default_seo_title")
  defaultSeoDescription String? @map("default_seo_description") @db.Text
  defaultSeoKeywords    String? @map("default_seo_keywords")
  defaultOgImage        String? @map("default_og_image")
  favicon               String?

  // Contact info (per-language)
  address               String? @db.Text
  phone                 String?
  email                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([languageCode])
  @@map("site_seo_configs")
}

// ==================== 4. Page ====================

model Page {
  id        String @id @default(cuid())
  pageType  String @map("page_type")
  name      String
  nameEn    String? @map("name_en")
  slug      String @unique
  status    Status @default(ACTIVE)
  navSort   Int    @default(0) @map("nav_sort")
  showInNav Boolean @default(true) @map("show_in_nav")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en") @db.Text
  seoKeywordsEn    String? @map("seo_keywords_en")
  seoTitleEs       String? @map("seo_title_es")
  seoDescriptionEs String? @map("seo_description_es") @db.Text
  seoKeywordsEs    String? @map("seo_keywords_es")
  seoTitleAr       String? @map("seo_title_ar")
  seoDescriptionAr String? @map("seo_description_ar") @db.Text
  seoKeywordsAr    String? @map("seo_keywords_ar")
  ogImage        String? @map("og_image")
  schemaOrg      Json?   @map("schema_org")

  modules PageModule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

// ==================== 5. Page Module ====================

model PageModule {
  id         String  @id @default(cuid())
  pageId     String  @map("page_id")
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  moduleType String  @map("module_type")
  title      String?
  subtitle   String?
  config     Json    @default("{}")

  sortOrder   Int     @default(0) @map("sort_order")
  isVisible   Boolean @default(true) @map("is_visible")
  customClass String? @map("custom_class")

  translations Translation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_modules")
}

model PageModuleTemplate {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  moduleType    String  @map("module_type")
  isEnabled     Boolean @default(true) @map("is_enabled")
  defaultConfig Json?   @map("default_config")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, moduleType])
  @@map("page_module_templates")
}

// ==================== 6. Product / Service ====================

model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?  @map("title_en")
  titleEs     String?  @map("title_es")
  titleAr     String?  @map("title_ar")
  slug        String   @unique
  summary     String?  @db.Text
  summaryEn   String?  @map("summary_en") @db.Text
  summaryEs   String?  @map("summary_es") @db.Text
  summaryAr   String?  @map("summary_ar") @db.Text

  coverImage String? @map("cover_image")
  gallery    Json?   @default("[]")

  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text
  descriptionEs String? @map("description_es") @db.Text
  descriptionAr String? @map("description_ar") @db.Text

  price         Decimal? @db.Decimal(10, 2)
  priceUnit     String?  @map("price_unit")
  priceCurrency String?  @default("USD") @map("price_currency")
  priceStrategy PriceDisplayStrategy @default(CONTACT) @map("price_strategy")

  features    String[] @default([])
  featuresEn  String[] @default([]) @map("features_en")
  featuresEs  String[] @default([]) @map("features_es")
  featuresAr  String[] @default([]) @map("features_ar")
  specs       Json?    @default("[]")
  specsEn     Json?    @default("[]") @map("specs_en")
  specsEs     Json?    @default("[]") @map("specs_es")
  specsAr     Json?    @default("[]") @map("specs_ar")

  sortOrder Int    @default(0) @map("sort_order")
  status    Status @default(ACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en") @db.Text
  seoKeywordsEn    String? @map("seo_keywords_en")
  seoTitleEs       String? @map("seo_title_es")
  seoDescriptionEs String? @map("seo_description_es") @db.Text
  seoKeywordsEs    String? @map("seo_keywords_es")
  seoTitleAr       String? @map("seo_title_ar")
  seoDescriptionAr String? @map("seo_description_ar") @db.Text
  seoKeywordsAr    String? @map("seo_keywords_ar")
  ogImage        String? @map("og_image")

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_items")
}

// ==================== 7. Case ====================

model CaseItem {
  id            String  @id @default(cuid())
  title         String
  titleEn       String? @map("title_en")
  titleEs       String? @map("title_es")
  titleAr       String? @map("title_ar")
  slug          String  @unique
  clientName    String? @map("client_name")
  coverImage    String? @map("cover_image")
  summary       String? @db.Text
  summaryEn     String? @map("summary_en") @db.Text
  summaryEs     String? @map("summary_es") @db.Text
  summaryAr     String? @map("summary_ar") @db.Text
  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text
  descriptionEs String? @map("description_es") @db.Text
  descriptionAr String? @map("description_ar") @db.Text

  sortOrder Int    @default(0) @map("sort_order")
  status    Status @default(ACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en") @db.Text
  seoKeywordsEn    String? @map("seo_keywords_en")
  seoTitleEs       String? @map("seo_title_es")
  seoDescriptionEs String? @map("seo_description_es") @db.Text
  seoKeywordsEs    String? @map("seo_keywords_es")
  seoTitleAr       String? @map("seo_title_ar")
  seoDescriptionAr String? @map("seo_description_ar") @db.Text
  seoKeywordsAr    String? @map("seo_keywords_ar")
  ogImage        String? @map("og_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("case_items")
}

// ==================== 8. News ====================

model NewsItem {
  id        String  @id @default(cuid())
  title     String
  titleEn   String? @map("title_en")
  titleEs   String? @map("title_es")
  titleAr   String? @map("title_ar")
  slug      String  @unique
  summary   String? @db.Text
  summaryEn String? @map("summary_en") @db.Text
  summaryEs String? @map("summary_es") @db.Text
  summaryAr String? @map("summary_ar") @db.Text
  coverImage String? @map("cover_image")
  content   String? @db.Text
  contentEn String? @map("content_en") @db.Text
  contentEs String? @map("content_es") @db.Text
  contentAr String? @map("content_ar") @db.Text
  author    String?
  tags      String[]
  tagsEn    String[]  @map("tags_en")
  tagsEs    String[]  @map("tags_es")
  tagsAr    String[]  @map("tags_ar")

  publishAt DateTime? @map("publish_at")
  status    Status    @default(INACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en") @db.Text
  seoKeywordsEn    String? @map("seo_keywords_en")
  seoTitleEs       String? @map("seo_title_es")
  seoDescriptionEs String? @map("seo_description_es") @db.Text
  seoKeywordsEs    String? @map("seo_keywords_es")
  seoTitleAr       String? @map("seo_title_ar")
  seoDescriptionAr String? @map("seo_description_ar") @db.Text
  seoKeywordsAr    String? @map("seo_keywords_ar")
  ogImage        String? @map("og_image")
  canonicalUrl   String? @map("canonical_url")
  schemaOrg      Json?   @map("schema_org")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news_items")
}

// ==================== 9. Language ====================

model Language {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  icon      String?
  isRtl     Boolean @default(false) @map("is_rtl")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  translations Translation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("languages")
}

// ==================== 10. Translation ====================

model Translation {
  id         String            @id @default(cuid())
  entityType EntityType        @map("entity_type")
  entityId   String            @map("entity_id")
  field      String

  languageId String   @map("language_id")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  content String            @db.Text
  status  TranslationStatus @default(UNTRANSLATED)

  pageModuleId String?     @map("page_module_id")
  pageModule   PageModule? @relation(fields: [pageModuleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, field, languageId])
  @@map("translations")
}

// ==================== 11. Code Snippet ====================

model CodeSnippet {
  id       String            @id @default(cuid())
  name     String
  code     String            @db.Text
  type     CodeType          @default(HTML)
  position InjectionPosition

  scope    String   @default("all")
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("code_snippets")
}

// ==================== 12. Contact Message ====================

model ContactMessage {
  id        String  @id @default(cuid())
  name      String
  email     String
  company   String?
  product   String?
  message   String  @db.Text
  isRead    Boolean @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ==================== 13. Order ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")

  customerName    String  @map("customer_name")
  customerCompany String? @map("customer_company")
  customerPhone   String? @map("customer_phone")
  customerEmail   String? @map("customer_email")
  shippingAddress String? @map("shipping_address") @db.Text

  items OrderItem[]

  totalAmount Decimal? @map("total_amount") @db.Decimal(12, 2)
  currency    String   @default("USD")

  status           OrderStatus @default(PENDING)
  expectedDelivery DateTime?   @map("expected_delivery")

  customerNote  String? @map("customer_note") @db.Text
  adminNote     String? @map("admin_note") @db.Text
  internalNotes Json?   @default("[]") @map("internal_notes")

  attachments Json? @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceItemId String?      @map("service_item_id")
  serviceItem   ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  productName     String  @map("product_name")
  productSpec     String? @map("product_spec")
  quantity        Int
  expectedPrice   Decimal? @map("expected_price") @db.Decimal(10, 2)
  expectedUnit    String?  @map("expected_unit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}
