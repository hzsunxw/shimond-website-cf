# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nimbus_cms?schema=public"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# File Storage (OSS)
OSS_ENDPOINT=""
OSS_BUCKET=""
OSS_ACCESS_KEY=""
OSS_SECRET_KEY=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Admin Panel Path (change to a random string for security, e.g. /a8x9k2m)
NEXT_PUBLIC_ADMIN_PATH="/admin"

# Unsplash API Key (optional, for better image search results)
# Get free key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Production Database
DB_USER="postgres"
DB_PASSWORD="changeme"
DB_NAME="nimbus_cms"
