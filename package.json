{
  "name": "shimond-cms-cf",
  "version": "1.0.0",
  "description": "Shimond CMS - Cloudflare D1 + R2 Edition",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:cf": "cross-env NEXT_PUBLIC_ADMIN_PATH=a20260628 ACTIVE_THEME=ver5 NEXT_PUBLIC_SITE_URL=https://shimondpvc.com npx @opennextjs/cloudflare build",
    "deploy": "npx @opennextjs/cloudflare deploy",
    "preview": "npx @opennextjs/cloudflare preview",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:create": "npx prisma db push --url \"file:./dev.db\" --accept-data-loss && node --experimental-sqlite scripts/dump-schema.cjs",
    "db:migrate:local": "npx wrangler d1 execute shimond-cms --local --file=prisma/migrations/0001_init.sql",
    "db:migrate:remote": "npx wrangler d1 execute shimond-cms --remote --file=prisma/migrations/0001_init.sql",
    "db:seed:local": "tsx scripts/generate-seed.ts && npx wrangler d1 execute shimond-cms --local --file=prisma/seed.sql",
    "db:seed:remote": "tsx scripts/generate-seed.ts && npx wrangler d1 execute shimond-cms --remote --file=prisma/seed.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260704.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jose": "^5.2.0",
    "next": "^15.5.20",
    "openai": "^6.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "lucide-react": "^0.300.0",
    "postcss": "^8.4.0",
    "prisma": "^6.19.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
