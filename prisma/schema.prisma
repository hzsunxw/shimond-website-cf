// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Core Enums ====================

enum Status {
  ACTIVE
  INACTIVE
  SCHEDULED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PRODUCING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PriceDisplayStrategy {
  EXACT
  RANGE
  CONTACT
}

enum CodeType {
  HTML
  CSS
  JAVASCRIPT
}

enum InjectionPosition {
  HEAD
  BODY_START
  BODY_END
}

enum EntityType {
  SITE
  PAGE
  PRODUCT
  CASE
  NEWS
  MODULE
}

enum TranslationStatus {
  TRANSLATED
  PENDING
  UNTRANSLATED
}

// ==================== 1. Admin User ====================

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  nickname  String?
  password  String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ==================== 2. Template ====================

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  coverImage  String?  @map("cover_image")
  identifier  String   @unique
  status      Status   @default(ACTIVE)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pageModuleTemplates PageModuleTemplate[]

  @@map("templates")
}

// ==================== 3. Site Config ====================

model SiteConfig {
  id              String  @id @default(cuid())
  companyName     String  @map("company_name")
  companyNameEn   String? @map("company_name_en")
  logo            String?
  primaryColor    String  @default("#0ea5e9") @map("primary_color")
  secondaryColor  String  @default("#f59e0b") @map("secondary_color")
  accentColor     String  @default("#10b981") @map("accent_color")
  siteTitle       String  @map("site_title")
  siteDescription String? @map("site_description") @db.Text
  footerInfo      String? @map("footer_info") @db.Text

  phone     String?
  email     String?
  address   String?
  mapUrl    String? @map("map_url")
  mapCoords String? @map("map_coords")

  socialLinks Json? @map("social_links")

  defaultLanguage String @default("zh") @map("default_language")

  defaultSeoTitle       String? @map("default_seo_title")
  defaultSeoDescription String? @map("default_seo_description") @db.Text
  defaultSeoKeywords    String? @map("default_seo_keywords")
  defaultOgImage        String? @map("default_og_image")
  favicon               String?

  currentTemplateId String? @map("current_template_id")

  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

// ==================== 4. Page ====================

model Page {
  id        String @id @default(cuid())
  pageType  String @map("page_type")
  name      String
  nameEn    String? @map("name_en")
  slug      String @unique
  status    Status @default(ACTIVE)
  navSort   Int    @default(0) @map("nav_sort")
  showInNav Boolean @default(true) @map("show_in_nav")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  canonicalUrl   String? @map("canonical_url")
  ogImage        String? @map("og_image")
  schemaOrg      Json?   @map("schema_org")

  modules PageModule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

// ==================== 5. Page Module ====================

model PageModule {
  id         String  @id @default(cuid())
  pageId     String  @map("page_id")
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  moduleType String  @map("module_type")
  title      String?
  subtitle   String?
  config     Json    @default("{}")

  sortOrder   Int     @default(0) @map("sort_order")
  isVisible   Boolean @default(true) @map("is_visible")
  customClass String? @map("custom_class")

  translations Translation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_modules")
}

model PageModuleTemplate {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  moduleType    String  @map("module_type")
  isEnabled     Boolean @default(true) @map("is_enabled")
  defaultConfig Json?   @map("default_config")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, moduleType])
  @@map("page_module_templates")
}

// ==================== 6. Product / Service ====================

model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?  @map("title_en")
  slug        String   @unique
  summary     String?  @db.Text
  summaryEn   String?  @map("summary_en") @db.Text

  coverImage String? @map("cover_image")
  gallery    Json?   @default("[]")

  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text

  price         Decimal? @db.Decimal(10, 2)
  priceUnit     String?  @map("price_unit")
  priceCurrency String?  @default("USD") @map("price_currency")
  priceStrategy PriceDisplayStrategy @default(CONTACT) @map("price_strategy")

  sortOrder Int    @default(0) @map("sort_order")
  status    Status @default(ACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  ogImage        String? @map("og_image")

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_items")
}

// ==================== 7. Case ====================

model CaseItem {
  id            String  @id @default(cuid())
  title         String
  titleEn       String? @map("title_en")
  slug          String  @unique
  clientName    String? @map("client_name")
  coverImage    String? @map("cover_image")
  summary       String? @db.Text
  summaryEn     String? @map("summary_en") @db.Text
  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text

  sortOrder Int    @default(0) @map("sort_order")
  status    Status @default(ACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  ogImage        String? @map("og_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("case_items")
}

// ==================== 8. News ====================

model NewsItem {
  id        String  @id @default(cuid())
  title     String
  titleEn   String? @map("title_en")
  slug      String  @unique
  summary   String? @db.Text
  summaryEn String? @map("summary_en") @db.Text
  coverImage String? @map("cover_image")
  content   String? @db.Text
  contentEn String? @map("content_en") @db.Text
  author    String?
  tags      String[]

  publishAt DateTime? @map("publish_at")
  status    Status    @default(INACTIVE)

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords")
  ogImage        String? @map("og_image")
  canonicalUrl   String? @map("canonical_url")
  schemaOrg      Json?   @map("schema_org")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news_items")
}

// ==================== 9. Language ====================

model Language {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  icon      String?
  isRtl     Boolean @default(false) @map("is_rtl")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  translations Translation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("languages")
}

// ==================== 10. Translation ====================

model Translation {
  id         String            @id @default(cuid())
  entityType EntityType        @map("entity_type")
  entityId   String            @map("entity_id")
  field      String

  languageId String   @map("language_id")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  content String            @db.Text
  status  TranslationStatus @default(UNTRANSLATED)

  pageModuleId String?     @map("page_module_id")
  pageModule   PageModule? @relation(fields: [pageModuleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId, field, languageId])
  @@map("translations")
}

// ==================== 11. Code Snippet ====================

model CodeSnippet {
  id       String            @id @default(cuid())
  name     String
  code     String            @db.Text
  type     CodeType          @default(HTML)
  position InjectionPosition

  scope    String   @default("all")
  isActive Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("code_snippets")
}

// ==================== 12. Contact Message ====================

model ContactMessage {
  id        String  @id @default(cuid())
  name      String
  email     String
  company   String?
  product   String?
  message   String  @db.Text
  isRead    Boolean @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_messages")
}

// ==================== 13. Order ====================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")

  customerName    String  @map("customer_name")
  customerCompany String? @map("customer_company")
  customerPhone   String? @map("customer_phone")
  customerEmail   String? @map("customer_email")
  shippingAddress String? @map("shipping_address") @db.Text

  items OrderItem[]

  totalAmount Decimal? @map("total_amount") @db.Decimal(12, 2)
  currency    String   @default("USD")

  status           OrderStatus @default(PENDING)
  expectedDelivery DateTime?   @map("expected_delivery")

  customerNote  String? @map("customer_note") @db.Text
  adminNote     String? @map("admin_note") @db.Text
  internalNotes Json?   @default("[]") @map("internal_notes")

  attachments Json? @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceItemId String?      @map("service_item_id")
  serviceItem   ServiceItem? @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  productName     String  @map("product_name")
  productSpec     String? @map("product_spec")
  quantity        Int
  expectedPrice   Decimal? @map("expected_price") @db.Decimal(10, 2)
  expectedUnit    String?  @map("expected_unit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}
